# Supabase設定
# Supabaseダッシュボード（https://supabase.com/dashboard）から取得
# Project Settings > API から確認できます

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# サーバーサイドでRLSをバイパスする必要がある場合に使用（招待受諾など）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 設定手順:
# 1. このファイルを .env.local にコピー
#    cp .env.local.example .env.local
# 2. Supabaseダッシュボードにログイン
# 3. 対象プロジェクトを選択
# 4. 左メニュー「Project Settings」→「API」
# 5. 以下の値をコピー:
#    - Project URL → NEXT_PUBLIC_SUPABASE_URL
#    - anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY

# Pushover通知設定（Claude Code作業完了通知用）
# https://pushover.net/ からトークンとユーザーキーを取得
PUSHOVER_APP_TOKEN=your-app-token-here
PUSHOVER_USER_KEY=your-user-key-here

# Slack Webhook設定（在庫通知用）
# Slack Appの Incoming Webhooks から取得
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# microCMS設定（画像ピッカー機能で使用）
# https://app.microcms.io/ でサービスを作成し、APIキーを取得
# ※ APIキーには「メディアの取得」権限が必要
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key

# Resend設定（チーム招待メール送信用）
# https://resend.com/ でアカウントを作成し、APIキーを取得
# テスト用には onboarding@resend.dev がFROMアドレスとして使用可能
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@your-domain.com
