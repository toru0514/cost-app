# Supabase設定
# Supabaseダッシュボード（https://supabase.com/dashboard）から取得
# Project Settings > API から確認できます

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 設定手順:
# 1. このファイルを .env.local にコピー
#    cp .env.local.example .env.local
# 2. Supabaseダッシュボードにログイン
# 3. 対象プロジェクトを選択
# 4. 左メニュー「Project Settings」→「API」
# 5. 以下の値をコピー:
#    - Project URL → NEXT_PUBLIC_SUPABASE_URL
#    - anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY

# Pushover通知設定（Claude Code作業完了通知用）
# https://pushover.net/ からトークンとユーザーキーを取得
PUSHOVER_APP_TOKEN=your-app-token-here
PUSHOVER_USER_KEY=your-user-key-here

# Slack Webhook設定（在庫通知用）
# Slack Appの Incoming Webhooks から取得
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# microCMS設定（商品・材料の画像ホスティング用）
# https://app.microcms.io/ でサービスを作成し、APIキーを取得
# ※ アプリ内でAPIを直接呼び出さず、URLのみ保存・表示するためドキュメント目的のみ
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key
